const express = require('express');
const router = express.Router();
const sessionController = require('../controllers/sessionController');
const uploadController = require('../controllers/uploadController');

router.post('/verify-token', sessionController.verifyToken);
router.post('/session/start', sessionController.startSession);
router.post('/session/finish', sessionController.finishSession);

router.get('/positions', sessionController.getPositions);
router.post('/positions/update', sessionController.updatePosition);

router.post('/positions/add', sessionController.addPosition);
router.post('/upload-one', uploadController.uploadMiddleware, uploadController.handleUpload);
router.post('/waiting/join', sessionController.joinWaiting);
router.get('/waiting/list', sessionController.getWaitingList);
module.exports = router;
